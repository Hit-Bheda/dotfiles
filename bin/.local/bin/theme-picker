#!/usr/bin/env bash
# Theme picker (rofi): list installed GTK themes, apply to GTK3/GTK4 + libadwaita,
# and advertise dark/light to Qt and Flatpak apps through the XDG portal.
#
#   theme-picker            pick with rofi
#   theme-picker <name>     apply directly (e.g. theme-picker Adwaita-dark)

set -euo pipefail

notify() { command -v notify-send >/dev/null && notify-send "Theme" "$1" || true; }

apply_theme() {
	local theme=$1 scheme=default
	[[ ${theme,,} == *dark* ]] && scheme=prefer-dark

	# GTK3 / GTK4 settings
	local ver dir
	for ver in 3.0 4.0; do
		dir="$HOME/.config/gtk-$ver"
		mkdir -p "$dir"
		cat >"$dir/settings.ini" <<-EOF
			[Settings]
			gtk-theme-name=$theme
			gtk-icon-theme-name=breeze-dark
			gtk-application-prefer-dark-theme=$([[ $scheme == prefer-dark ]] && echo 1 || echo 0)
		EOF
	done

	# GNOME/libadwaita + portal (Qt, Flatpak, libadwaita follow this)
	if command -v gsettings >/dev/null 2>&1; then
		gsettings set org.gnome.desktop.interface gtk-theme "$theme" 2>/dev/null || true
		gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || true
		gsettings set org.gnome.desktop.interface icon-theme "breeze-dark" 2>/dev/null || true
	fi

	notify "$theme applied ($scheme) — restart open apps to see it"
	echo "$theme"
}

themes() {
	local d t
	{
		for d in /usr/share/themes "$HOME/.local/share/themes"; do
			[[ -d $d ]] || continue
			for t in "$d"/*/; do
				[[ -d $t/gtk-3.0 || -d $t/gtk-4.0 ]] && basename "$t"
			done
		done
		# Built into GTK, not present in /usr/share/themes
		echo "Adwaita"
		echo "Adwaita-dark"
	} | sort -u
}

if [[ $# -gt 0 ]]; then
	apply_theme "$1"
	exit 0
fi

pgrep -x rofi >/dev/null && exit 0

current=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'" || true)

choice=$(
	themes |
		awk -v cur="$current" '
			$0 == cur { printf "%s\0icon\x1fpreferences-desktop-theme\x1fmeta\x1f(current)\n", $0; next }
			{ printf "%s\0icon\x1fpreferences-desktop-theme\n", $0 }
		' |
		rofi -dmenu -i -p "GTK theme" -show-icons -l 12 \
			-theme-str 'window { width: 380px; }'
) || exit 0

[[ -n ${choice:-} ]] || exit 0
apply_theme "$choice"
