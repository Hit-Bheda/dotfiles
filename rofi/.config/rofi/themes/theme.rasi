/* Rofi theme — Minimal monochrome black & white.
 *
 * Background: near-black
 * Border: 2px white
 * Radius: 0 (sharp edges)
 * Input/entries: charcoal / translucent white selection
 *
 * The palette (bg, fg, accent, accent-dim, surface, muted, urgent) is
 * generated by `theme-apply` into colors.rasi — change it in
 * themes/<name>/theme.conf, not here.
 */

@import "colors.rasi"
@import "icons.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            500px;
    location:         center;
    anchor:           center;
    border:           2px;
    border-color:     @accent;
    border-radius:    0;
    background-color: @bg;
}

mainbox {
    spacing:  8px;
    padding:  6px;
}

inputbar {
    margin:           4px;
    padding:          8px;
    spacing:          8px;
    background-color: @surface;
    border-radius:    0;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding:    0 6px 0 0;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @muted;
}

listview {
    columns:   1;
    lines:     10;
    spacing:   4px;
    padding:   0 4px 4px 4px;
    scrollbar: false;
}

element {
    padding:          8px;
    spacing:          8px;
    border-radius:    0;
    background-color: transparent;
    text-color:       @fg;
}

element selected {
    background-color: @accent-dim;
    border-radius:    0;
    text-color:       @fg;
}

element-icon {
    size:    24px;
    padding: 0 6px 0 0;
}

element-text {
    vertical-align: 0.5;
}

scrollbar {
    handle-width:  4px;
    handle-color:  @accent;
    border-radius: 0;
}

/* Error state */
element.urgent {
    text-color: @urgent;
}
