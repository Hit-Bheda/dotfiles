/* Rofi configuration — migrated from the old wofi setup.
 * Theme lives in ~/.config/rofi/themes/theme.rasi
 */

@theme "theme"

configuration {
    /* Was: wofi --show drun */
    modes:                "drun,run,window,ssh";
    drun-display-format:  "{name}";
    show-icons:           true;              /* wofi allow_images=true */
    application-fallback-icon: "application-x-executable";

    font:                 "JetBrainsMono Nerd Font Mono 12";
    matching:             "fuzzy";           /* wofi matching=fuzzy */
    case-sensitive:       false;
    tokenize:             true;
    sorting-method:       "normal";

    fixed-num-lines:      true;
    terminal:             "kitty";
    hover-select:         true;

    disable-history:      false;
    drun-show-actions:    false;
    window-match-fields:  "all";
}
