# Generated by `theme-apply` from themes/{{theme}}/theme.conf.
# Do not edit by hand: change the palette in the theme instead.
#
# Installed as ~/.config/kdeglobals and as
# ~/.local/share/color-schemes/{{name}}.colors, so KDE / KF6 apps
# (Dolphin, Ark, Kate, ...) use this palette through KColorScheme.

[General]
ColorScheme={{name}}
Name={{name}}
shadeSortColumn=true

[Icons]
Theme={{icon_theme}}

[KDE]
contrast=4

[WM]
